# =============================================================================
# Askmink — Environment Configuration
# Copy to .env and fill in secrets. Never commit .env to Git.
# =============================================================================

# Runtime mode: self-hosted (local email/password + local disk) | cloud (Auth0 + S3)
APP_MODE=self-hosted
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:5173

# PostgreSQL 18 + pgvector
POSTGRES_USER=askmink
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=askmink
DATABASE_URL=postgresql://askmink:change_me_strong_db_password@127.0.0.1:5432/askmink

# Master encryption key (32-byte hex = 64 hex chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session signing secret (32-byte hex). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional default Vercel AI Gateway token & models (configure via ./scripts/configure-ai-gateway.sh)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
DEFAULT_CHAT_MODEL=tencent/hy4-flash
DEFAULT_EMBEDDING_MODEL=alibaba/qwen3-embedding-0.6b

# File storage: local (default) | s3 (cloud)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads

# Optional S3-compatible storage (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional SMTP for booking .ics notifications (self-hosted works without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Askmink <noreply@askmink.local>

# Optional Auth0 (only when APP_MODE=cloud)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
